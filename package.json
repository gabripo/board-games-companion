{
  "name": "board-games-companion",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "pnpm fixtures && turbo run dev --filter @bgc/web",
    "fixtures": "tsx packages/schema/src/cli/build-fixtures.ts",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "turbo run test",
    "validate": "tsx packages/schema/src/cli/validate.ts",
    "schemas": "tsx packages/schema/src/cli/export-json-schema.ts",
    "build": "pnpm validate && pnpm fixtures && turbo run build",
    "build:games": "VITE_CONTENT=games pnpm build",
    "preview:games": "VITE_CONTENT=games pnpm --filter @bgc/web preview",
    "deploy:pages": "pnpm build:games && pnpm dlx wrangler@4 pages deploy apps/web/dist --project-name ${CF_PAGES_PROJECT:-board-games-companion} --branch main",
    "e2e": "pnpm fixtures && pnpm --filter @bgc/web e2e",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm validate"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/node": "^22.19.0",
    "tsx": "^4.23.15",
    "turbo": "^2.11.11",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
