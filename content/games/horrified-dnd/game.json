        "en": "Hero Phase",
        "it": "Fase degli Eroi"
      },
      "definition": {
        "en": "First half of your turn: take up to 4 actions; anyone may play Perk cards.",
        "it": "Prima metà del turno: fino a 4 azioni; chiunque può giocare carte Vantaggio."
      },
      "aliases": {
        "en": ["Fase degli Eroi"],
        "it": ["Hero Phase"]
      },
      "ruleRefs": ["hero-phase"]
