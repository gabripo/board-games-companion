  "variants": [
    {
      "id": "monster-beholder",
      "kind": "variant",
      "name": {
        "en": "Monster: Beholder",
        "it": "Mostro: Beholder"
      },
      "description": {
        "en": "Frenzy 4 · damage all 10 eyestalks, then blind the antimagic eye.",
        "it": "Frenesia 4 · danneggia tutti i 10 peduncoli oculari, poi acceca l'occhio antimagia."
      }
    },
    {
      "id": "monster-displacer-beast",
      "kind": "variant",
      "name": {
        "en": "Monster: Displacer Beast",
        "it": "Mostro: Displacer Beast"
      },
      "description": {
        "en": "Frenzy 1 · cover the displacement field with Items, then roll to strike its true location.",
        "it": "Frenesia 1 · copri il campo di dislocazione con Oggetti, poi tira per colpire la sua vera posizione."
      }
    },
    {
      "id": "monster-mimic",
      "kind": "variant",
      "name": {
        "en": "Monster: Mimic",
        "it": "Mostro: Mimic"
      },
      "description": {
        "en": "Frenzy 5 · it starts hidden on its mat: make it appear, then defeat it fast.",
        "it": "Frenesia 5 · parte nascosto sulla sua plancia: fallo apparire, poi sconfiggilo in fretta."
      }
    },
    {
      "id": "monster-red-dragon",
      "kind": "variant",
      "name": {
        "en": "Monster: Red Dragon",
        "it": "Mostro: Drago Rosso"
      },
      "description": {
        "en": "Frenzy 6 · two-mat campaign: free the Orb of Dragonkind, lure the Dragon to its Hoard, destroy it.",
        "it": "Frenesia 6 · campagna su due plance: libera il Globo dei Draghi, attira il Drago nel suo Tesoro, distruggilo."
      }
    },
