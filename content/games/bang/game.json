  "variants": [
    {
      "id": "simplified",
      "kind": "beginner",
      "name": {
        "en": "Simplified deck (first games)",
        "it": "Mazzo semplificato (prime partite)"
      },
      "description": {
        "en": "Remove every playing card marked with the book symbol before shuffling.",
        "it": "Prima di mescolare, togli dal mazzo tutte le carte con il simbolo del libro."
      }
    },
    {
      "id": "shadow-gunslingers",
      "kind": "variant",
      "name": {
        "en": "Shadow-gunslingers (Gold Rush)",
        "it": "Pistoleri fantasma (Gold Rush)"
      },
      "description": {
        "en": "Eliminated players come back on each of their turns as shadows with 0 life points.",
        "it": "Gli eliminati tornano a ogni loro turno come ombre con 0 punti vita."
      }
    }
  ],
  "expansions": [
    {
      "id": "dodge-city",
      "name": {
        "en": "Dodge City",
        "it": "Dodge City"
      },
      "description": {
        "en": "15 characters, 40 cards with the new green-bordered cards, and rules for 3 and 8 players.",
        "it": "15 personaggi, 40 carte con le nuove carte a bordo verde, e regole per 3 e 8 giocatori."
      }
    },
    {
      "id": "high-noon",
      "name": {
        "en": "High Noon",
        "it": "High Noon (Mezzogiorno di Fuoco)"
      },
      "description": {
        "en": "13 event cards: each round a new card changes the rules for everyone. Also in the Dodge City box.",
        "it": "13 carte evento: a ogni giro una nuova carta cambia le regole per tutti. Inclusa anche nella scatola di Dodge City."
      }
    },
    {
      "id": "fistful-of-cards",
      "name": {
        "en": "A Fistful of Cards",
        "it": "A Fistful of Cards (Per un Pugno di Carte)"
      },
      "description": {
        "en": "15 event cards played like High Noon (the two decks can be mixed).",
        "it": "15 carte evento che si giocano come High Noon (i due mazzi si possono mescolare)."
      }
    },
    {
      "id": "wild-west-show",
      "name": {
        "en": "Wild West Show",
        "it": "Wild West Show"
      },
      "description": {
        "en": "8 characters and 10 show cards that change the rules whenever a Stagecoach or Wells Fargo is played.",
        "it": "8 personaggi e 10 carte spettacolo che cambiano le regole ogni volta che si gioca una Diligenza o una Wells Fargo."
      }
    },
    {
      "id": "gold-rush",
      "name": {
        "en": "Gold Rush",
        "it": "Gold Rush"
      },
      "description": {
        "en": "Earn gold nuggets for every wound you inflict and spend them on 24 equipment cards. Also adds 8 characters and the shadow-gunslinger variant.",
        "it": "Guadagni pepite per ogni ferita inflitta e le spendi in 24 carte equipaggiamento. Aggiunge anche 8 personaggi e la variante dei pistoleri fantasma."
      }
    },
    {
      "id": "valley-of-shadows",
      "name": {
        "en": "The Valley of Shadows",
        "it": "La Valle delle Ombre"
      },
      "description": {
        "en": "8 characters and 16 playing cards, including Ghosts that bring eliminated players back.",
        "it": "8 personaggi e 16 carte da gioco, tra cui i Fantasmi che riportano in gioco gli eliminati."
      }
    },
    {
      "id": "armed-dangerous",
      "name": {
        "en": "Armed & Dangerous",
        "it": "Armed & Dangerous (Armati e pericolosi)"
      },
      "description": {
        "en": "Load tokens power orange Dangerous cards and upgrade brown cards. 8 characters, 28 cards.",
        "it": "I segnalini carica attivano le carte arancioni Dangerous e potenziano le carte marroni. 8 personaggi, 28 carte."
      }
    },
    {
      "id": "great-train-robbery",
      "name": {
        "en": "The Great Train Robbery",
        "it": "The Great Train Robbery"
      },
      "description": {
        "en": "A train crosses the stations: pay a station's cost to take powerful railcars. 8 characters, 16 cards.",
        "it": "Un treno attraversa le stazioni: paga il costo di una stazione per prendere vagoni potenti. 8 personaggi, 16 carte."
      }
    },
    {
      "id": "legends",
      "name": {
        "en": "Legends",
        "it": "Legends"
      },
      "description": {
        "en": "16 legendary versions of the base characters, Feat cards and Fame tokens: complete feats to become a Legend.",
        "it": "16 versioni leggendarie dei personaggi base, carte Impresa e segnalini Fama: compi imprese per diventare Leggenda."
      }
    },
    {
      "id": "most-wanted",
      "name": {
        "en": "Most Wanted",
        "it": "Most Wanted"
      },
      "description": {
        "en": "Promo pack: 5 characters, 2 extra High Noon-style events (Handcuffs, New Identity) and blank cards.",
        "it": "Pacchetto promo: 5 personaggi, 2 eventi in stile High Noon (Manette, Nuova identità) e carte bianche."
      }
    }
  ],
