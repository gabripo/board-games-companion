  "glossary": [
    {
      "id": "sheriff",
      "term": {
        "en": "Sheriff",
        "it": "Sceriffo"
      },
      "definition": {
        "en": "The only public role. Wins with the Deputies when all Outlaws and the Renegade are dead.",
        "it": "L'unico ruolo palese. Vince con i Vice quando Fuorilegge e Rinnegato sono tutti eliminati."
      },
      "aliases": {
        "en": ["Sceriffo"],
        "it": ["Sheriff"]
      },
      "icon": {
        "sceneId": "roles",
        "hotspotId": "sheriff"
      },
      "ruleRefs": ["role-goals", "sheriff-revealed"]
    },
    {
      "id": "deputy",
      "term": {
        "en": "Deputy",
        "it": "Vice"
      },
      "definition": {
        "en": "Secretly helps the Sheriff and shares the Sheriff's goal.",
        "it": "Aiuta in segreto lo Sceriffo e ne condivide l'obiettivo."
      },
      "aliases": {
        "en": ["Vice"],
        "it": ["Deputy"]
      },
      "ruleRefs": ["role-goals"],
      "icon": {
        "sceneId": "roles",
        "hotspotId": "deputy"
      }
    },
    {
      "id": "outlaw",
      "term": {
        "en": "Outlaw",
        "it": "Fuorilegge"
      },
      "definition": {
        "en": "Wins if the Sheriff dies. Whoever kills an Outlaw draws 3 cards.",
        "it": "Vince se lo Sceriffo muore. Chi elimina un Fuorilegge pesca 3 carte."
      },
      "aliases": {
        "en": ["Fuorilegge"],
        "it": ["Outlaw"]
      },
      "ruleRefs": ["role-goals", "outlaw-reward"],
      "icon": {
        "sceneId": "roles",
        "hotspotId": "outlaw"
      }
    },
    {
      "id": "renegade",
      "term": {
        "en": "Renegade",
        "it": "Rinnegato"
      },
      "definition": {
        "en": "Wants to be the last character alive — the Sheriff must die last.",
        "it": "Vuole restare l'ultimo personaggio in gioco: lo Sceriffo deve morire per ultimo."
      },
      "aliases": {
        "en": ["Rinnegato"],
        "it": ["Renegade"]
      },
      "ruleRefs": ["role-goals", "game-end"],
      "icon": {
        "sceneId": "roles",
        "hotspotId": "renegade"
      }
    },
    {
      "id": "life-points",
      "term": {
        "en": "Life points (bullets)",
        "it": "Punti vita (pallottole)"
      },
      "definition": {
        "en": "How many hits you can take; also your hand limit at the end of your turn.",
        "it": "Quanti colpi puoi subire; sono anche il limite di carte in mano a fine turno."
      },
      "aliases": {
        "en": ["Punti vita (pallottole)"],
        "it": ["Life points (bullets)"]
      },
      "icon": {
        "sceneId": "player-area",
        "hotspotId": "life"
      },
      "ruleRefs": ["life-points", "hand-limit"]
    },
    {
      "id": "distance",
      "term": {
        "en": "Distance",
        "it": "Distanza"
      },
      "definition": {
        "en": "Fewest seats between two players, counting either way round. Neighbours are at 1.",
        "it": "Numero minimo di posti tra due giocatori, contando in un senso o nell'altro. I vicini sono a 1."
      },
      "aliases": {
        "en": ["Distanza"],
        "it": ["Distance"]
      },
      "ruleRefs": ["distance"]
