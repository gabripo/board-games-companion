        "it": "Carte riassuntive"
      },
      "quantity": 7
    },
    {
      "id": "player-boards",
      "type": "player-board",
      "name": {
        "en": "Playing boards",
        "it": "Plance"
      },
      "quantity": 7,
      "description": {
        "en": "Holds your role, character, weapon and bullets. The Colt .45 is printed on it.",
        "it": "Contiene ruolo, personaggio, arma e pallottole. Vi è disegnata la Colt .45."
      },
      "sceneRefs": [
        {
          "sceneId": "player-area",
          "hotspotId": "weapon"
        }
      ]
