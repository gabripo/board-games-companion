      },
      "quantity": 16,
      "description": {
        "en": "Each shows a special ability and the starting life points (bullets).",
        "it": "Ognuna riporta un'abilità speciale e i punti vita iniziali (pallottole)."
      },
      "sceneRefs": [
        {
          "sceneId": "characters"
        }
      ]
    },
    {
      "id": "playing-cards",
      "type": "card",
      "name": {
        "en": "Playing cards",
        "it": "Carte da gioco"
      },
      "quantity": 80,
      "description": {
        "en": "Brown-bordered cards are played and discarded; blue-bordered cards stay in play in front of you.",
        "it": "Le carte a bordo marrone si giocano e si scartano; quelle a bordo blu restano in gioco davanti a te."
      },
      "sceneRefs": [
        {
          "sceneId": "playing-cards"
        },
        {
