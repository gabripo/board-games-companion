# Cloudflare Pages response headers (copied to dist/ by Vite).
# Private app: keep it out of search engines.
/*
  X-Robots-Tag: noindex, nofollow
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Always revalidate the entry points so a new build is picked up at once.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/sw.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache

# Hashed build assets never change.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Guide bundles and images keep stable names: revalidate (offline copies live in the service worker).
/games/*
  Cache-Control: no-cache
